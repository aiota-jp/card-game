[
  {
    "id": "welcome-01",
    "kind": "welcome",
    "text": "こんにちは、アヤカです！ いっしょにバカラを楽しみましょう。"
  },
  {
    "id": "welcome-02",
    "kind": "welcome",
    "text": "会えてうれしいです！ 今日は、どのゲームにしますか？"
  },
  {
    "id": "welcome-03",
    "kind": "welcome",
    "text": "準備はいいですか？ それじゃあ、始めましょう！"
  },
  {
    "id": "welcome-04",
    "kind": "welcome",
    "text": "お帰りなさい！ 続きも、いっしょに楽しみましょう。"
  },
  {
    "id": "deal-01",
    "kind": "deal",
    "text": "新しいカードです。どんな一手になるか、楽しみですね。"
  },
  {
    "id": "deal-02",
    "kind": "deal",
    "text": "次のハンドへ。今度は、どう攻めますか？"
  },
  {
    "id": "deal-03",
    "kind": "deal",
    "text": "カードを配りました。慌てず、見てみてください。"
  },
  {
    "id": "deal-04",
    "kind": "deal",
    "text": "さて、次の勝負です。よろしくお願いします。"
  },
  {
    "id": "win-01",
