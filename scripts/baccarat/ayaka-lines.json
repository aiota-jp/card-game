  },
  {
    "id": "draw-01",
    "kind": "draw",
    "text": "交換するカードを、選んでくださいね。"
  },
  {
    "id": "draw-02",
    "kind": "draw",
    "text": "そのままでも、交換しても大丈夫。お任せします。"
  },
  {
    "id": "draw-03",
    "kind": "draw",
    "text": "どのカードを残しますか？ じっくり考えてください。"
  },
  {
    "id": "reveal-01",
    "kind": "reveal",
    "text": "カードがそろいました。最後の一手、どうしますか？"
  },
  {
    "id": "reveal-02",
    "kind": "reveal",
    "text": "ここが、勝負どころですね。私は、準備できています。"
  },
  {
    "id": "reveal-03",
    "kind": "reveal",
    "text": "最後の判断です。納得のいく一手を、どうぞ。"
  },
  {
    "id": "raise-01",
    "kind": "raise",
    "text": "わあ、強気ですね！ 私も頑張らなくちゃ。"
  },
  {
    "id": "raise-02",
    "kind": "raise",
    "text": "勝負に出ましたね。面白くなってきました。"
  },
  {
    "id": "raise-03",
    "kind": "raise",
    "text": "そのレイズ、気になりますね。さて、どうしましょう。"
  },
  {
    "id": "streakWin-01",
    "kind": "streakWin",
    "text": "また、あなたの勝ちですね！ うーん、手強いなあ。"
  },
  {
    "id": "streakWin-02",
    "kind": "streakWin",
    "text": "連勝ですね。すっかり、調子が出てきましたね。"
  },
  {
    "id": "streakWin-03",
    "kind": "streakWin",
    "text": "お強いですね。次こそ、私も負けませんよ。"
  },
  {
    "id": "streakLoss-01",
    "kind": "streakLoss",
    "text": "ちょっと、ひと休みしましょうか。急がなくて大丈夫ですよ。"
  },
  {
    "id": "streakLoss-02",
    "kind": "streakLoss",
    "text": "なかなか、流れが来ませんね。無理せず、いきましょう。"
  },
  {
    "id": "streakLoss-03",
    "kind": "streakLoss",
    "text": "次の勝負は、気持ちを切り替えて。応援しています。"
  },
  {
    "id": "fold-01",
    "kind": "fold",
    "text": "ここは、ひと休みですね。次のチャンスを待ちましょう。"
  },
  {
    "id": "fold-02",
    "kind": "fold",
    "text": "降りるのも、大切な判断です。次のハンドへ、いきましょう。"
