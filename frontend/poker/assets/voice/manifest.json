  "lines": [
    {
      "id": "welcome-01",
      "kind": "welcome",
      "text": "ラウンジへようこそ。今夜は、ゆっくり楽しんでいってくださいね。",
      "files": {
        "expressive": {
          "path": "assets/voice/welcome-01-expressive.wav",
          "sha256": "31d7bbcf0753d424752ff4b1249da79c27b282176fed8b4782610605f9c006ec",
          "duration": 4.894263038548753,
          "style_id": 1388823424,
          "intonationScale": 0.9,
          "postPitchScale": 1.1
        },
        "calm": {
          "path": "assets/voice/welcome-01-calm.wav",
          "sha256": "da8d766e55549b2e5c4d5563fd676f2ddf4018b9cf048a6a37ed3ff94d199370",
          "duration": 4.8321768707483,
          "style_id": 1388823424,
          "intonationScale": 0.765,
          "postPitchScale": 1.1
        }
      }
    },
    {
      "id": "welcome-02",
      "kind": "welcome",
      "text": "いらっしゃいませ。お会いできて、うれしいです。",
      "files": {
        "expressive": {
          "path": "assets/voice/welcome-02-expressive.wav",
          "sha256": "f97c81f22c16b6bc6278b1ccb577f76acae58d617579be1b670a7c64e4074208",
          "duration": 3.526802721088435,
          "style_id": 1388823424,
          "intonationScale": 0.9,
          "postPitchScale": 1.1
        },
        "calm": {
          "path": "assets/voice/welcome-02-calm.wav",
          "sha256": "d906289246c5be1e1a4bbb407e6c650b34d78d37a02b94b4183bc6595cfdc073",
          "duration": 3.4848979591836735,
          "style_id": 1388823424,
          "intonationScale": 0.765,
          "postPitchScale": 1.1
        }
      }
    },
    {
      "id": "welcome-03",
      "kind": "welcome",
      "text": "準備はいいですか？ それでは、始めましょう。",
      "files": {
        "expressive": {
          "path": "assets/voice/welcome-03-expressive.wav",
          "sha256": "79eb600d255207139d9e519a2f3cef89205650d3f5bd4a26c2b7443cc50cf312",
          "duration": 3.6328798185941045,
          "style_id": 1388823424,
          "intonationScale": 0.9,
          "postPitchScale": 1.1
        },
        "calm": {
          "path": "assets/voice/welcome-03-calm.wav",
          "sha256": "e733d54409c96f141bd50536e55890327d18a5b33b4a5468bfeac0f16142bbd0",
          "duration": 3.6263945578231294,
          "style_id": 1388823424,
          "intonationScale": 0.765,
          "postPitchScale": 1.1
        }
      }
    },
    {
      "id": "welcome-04",
      "kind": "welcome",
      "text": "お帰りなさい。続きを、ご一緒しましょう。",
      "files": {
        "expressive": {
          "path": "assets/voice/welcome-04-expressive.wav",
          "sha256": "c5c74d06f183805a9263c9286484071b778faab68427f261ab88214b99279cb9",
          "duration": 3.546077097505669,
          "style_id": 1388823424,
          "intonationScale": 0.9,
          "postPitchScale": 1.1
        },
        "calm": {
          "path": "assets/voice/welcome-04-calm.wav",
          "sha256": "d4cb824361e341073f742e41e68126db31d522f47b4f8817db8129c453533f68",
          "duration": 3.5226757369614514,
          "style_id": 1388823424,
          "intonationScale": 0.765,
          "postPitchScale": 1.1
        }
      }
    },
    {
      "id": "deal-01",
      "kind": "deal",
      "text": "新しいカードです。どんな一手になるか、楽しみですね。",
      "files": {
        "expressive": {
          "path": "assets/voice/deal-01-expressive.wav",
          "sha256": "21d45968a7e47c863006cc9612a3537b188eb252ac2ebca73b2d2f16b25a42d4",
          "duration": 4.519478458049886,
          "style_id": 1388823424,
          "intonationScale": 0.9,
          "postPitchScale": 1.1
        },
        "calm": {
          "path": "assets/voice/deal-01-calm.wav",
          "sha256": "3652d38def43ed40be18346e8b38346f8666bd920f85a533ceea6683e861b9e7",
          "duration": 4.490045351473923,
          "style_id": 1388823424,
          "intonationScale": 0.765,
          "postPitchScale": 1.1
        }
      }
    },
    {
      "id": "deal-02",
      "kind": "deal",
      "text": "次のハンドへ。今度は、どう攻めますか？",
      "files": {
        "expressive": {
          "path": "assets/voice/deal-02-expressive.wav",
          "sha256": "413f5ec7000f89059c4af4e986a5643acc3aaf5ebf1f22eb03e1265f9a473c26",
          "duration": 3.520453514739229,
          "style_id": 1388823424,
          "intonationScale": 0.9,
          "postPitchScale": 1.1
        },
        "calm": {
          "path": "assets/voice/deal-02-calm.wav",
          "sha256": "ee66045a59bfcc48926a466e486c21485770794b7a77b1e9de295a77dea1c663",
          "duration": 3.4492517006802723,
          "style_id": 1388823424,
          "intonationScale": 0.765,
          "postPitchScale": 1.1
        }
      }
    },
    {
      "id": "deal-03",
      "kind": "deal",
      "text": "カードを配りました。慌てず、見てみてください。",
      "files": {
        "expressive": {
          "path": "assets/voice/deal-03-expressive.wav",
          "sha256": "815edc2659f4fb97451d01e5296fd4a8a45d565b0b81fe18c86692a5e5b34aba",
          "duration": 3.900045351473923,
          "style_id": 1388823424,
          "intonationScale": 0.9,
          "postPitchScale": 1.1
        },
        "calm": {
          "path": "assets/voice/deal-03-calm.wav",
          "sha256": "20c20cb149e1ca3a6582b109ca86a5c2cda5298002adae35f05511f6cf5adc08",
          "duration": 3.865215419501134,
          "style_id": 1388823424,
          "intonationScale": 0.765,
          "postPitchScale": 1.1
        }
      }
    },
    {
      "id": "deal-04",
      "kind": "deal",
      "text": "さて、次の勝負です。よろしくお願いします。",
      "files": {
        "expressive": {
          "path": "assets/voice/deal-04-expressive.wav",
          "sha256": "f6aa1d4e1dcc9099029d824b2b77de6c05b99cf915a74b7ef6a4c01f0ea89f03",
          "duration": 3.7824489795918366,
          "style_id": 1388823424,
          "intonationScale": 0.9,
          "postPitchScale": 1.1
        },
        "calm": {
          "path": "assets/voice/deal-04-calm.wav",
          "sha256": "fdf1178e79d4d2e0c97cf00bb4aed837bf4aab3fd9b5dded5e15b64883eb12e3",
          "duration": 3.7718367346938777,
          "style_id": 1388823424,
          "intonationScale": 0.765,
          "postPitchScale": 1.1
        }
      }
    },
    {
      "id": "win-01",
      "kind": "win",
      "text": "お見事です。きれいに決まりましたね。",
      "files": {
        "expressive": {
          "path": "assets/voice/win-01-expressive.wav",
          "sha256": "5e62658976c8066d03a748c050cfd152f1e90ec9db04e193c2b66d588bdf941d",
          "duration": 3.0298639455782315,
          "style_id": 1388823424,
          "intonationScale": 0.9,
          "postPitchScale": 1.1
        },
        "calm": {
          "path": "assets/voice/win-01-calm.wav",
          "sha256": "8e607b9b255affbdac8d682c1a79f9a4930985bf971305473101f1e91eca63ce",
          "duration": 3.107800453514739,
          "style_id": 1388823424,
          "intonationScale": 0.765,
          "postPitchScale": 1.1
        }
      }
    },
    {
      "id": "win-02",
      "kind": "win",
      "text": "あなたの勝ちです。さすがですね。",
      "files": {
        "expressive": {
          "path": "assets/voice/win-02-expressive.wav",
          "sha256": "8acd9c4ec086577902c441acd7bff546d9331ea3cf5a73c389b51137eb899219",
          "duration": 2.5836507936507935,
          "style_id": 1388823424,
          "intonationScale": 0.9,
          "postPitchScale": 1.1
        },
        "calm": {
          "path": "assets/voice/win-02-calm.wav",
          "sha256": "891fd892998899e7ce7a9753e7ee5c74c368931c34fb5305a08e6730c2085501",
          "duration": 2.733968253968254,
          "style_id": 1388823424,
          "intonationScale": 0.765,
          "postPitchScale": 1.1
        }
      }
    },
    {
      "id": "win-03",
      "kind": "win",
      "text": "あら、負けちゃいました。いい勝負でしたね。",
      "files": {
        "expressive": {
          "path": "assets/voice/win-03-expressive.wav",
          "sha256": "160e7350f7d49bf32a8050d9cca901f872c8f823a406d06baa9ffe37a3620d4b",
          "duration": 3.4450566893424037,
          "style_id": 1388823424,
          "intonationScale": 0.9,
          "postPitchScale": 1.1
        },
        "calm": {
          "path": "assets/voice/win-03-calm.wav",
          "sha256": "85563db2453231b9452f156a1478a427b2e691649951d02c05976f890c84ab11",
          "duration": 3.446575963718821,
          "style_id": 1388823424,
          "intonationScale": 0.765,
          "postPitchScale": 1.1
        }
      }
    },
    {
      "id": "win-04",
      "kind": "win",
      "text": "その一手、素敵でした。次は私も頑張ります。",
      "files": {
        "expressive": {
          "path": "assets/voice/win-04-expressive.wav",
          "sha256": "2040f439f081b71419bbbb5f7430364163e28c72a0d779a1bbd016cd6d53e862",
          "duration": 4.25501133786848,
          "style_id": 1388823424,
          "intonationScale": 0.9,
          "postPitchScale": 1.1
        },
        "calm": {
          "path": "assets/voice/win-04-calm.wav",
          "sha256": "b6654bbef3f9f4ca8cc17e15b8e45792840ff4fffc7a6ab788193c5190b477c6",
          "duration": 4.205102040816326,
          "style_id": 1388823424,
          "intonationScale": 0.765,
          "postPitchScale": 1.1
        }
      }
    },
    {
      "id": "win-05",
      "kind": "win",
      "text": "やられましたね。思わず見入ってしまいました。",
      "files": {
        "expressive": {
          "path": "assets/voice/win-05-expressive.wav",
          "sha256": "9abaf35244dbcabb83100adfa2189a6b942320ae578809ef4f8d1b61e30c3e41",
          "duration": 3.4730385487528346,
          "style_id": 1388823424,
          "intonationScale": 0.9,
          "postPitchScale": 1.1
        },
        "calm": {
          "path": "assets/voice/win-05-calm.wav",
          "sha256": "fefb3d0d5b462ac1ac380860bb70a80fb394e26e9d6c0e48349e8a59a486b211",
          "duration": 3.399863945578231,
          "style_id": 1388823424,
          "intonationScale": 0.765,
          "postPitchScale": 1.1
        }
      }
    },
    {
      "id": "win-06",
      "kind": "win",
      "text": "おめでとうございます。次の勝負も、楽しみです。",
      "files": {
        "expressive": {
          "path": "assets/voice/win-06-expressive.wav",
          "sha256": "fb7a82ffeb1b2d95388a83b6fa9cc274686f0b0f7d68ff4a9cc14d62148f5ad4",
          "duration": 4.110453514739229,
          "style_id": 1388823424,
          "intonationScale": 0.9,
          "postPitchScale": 1.1
        },
        "calm": {
          "path": "assets/voice/win-06-calm.wav",
          "sha256": "3b5796934d6f4d77ff0b656c1c6d99b11a6214e3971bfad8b854829a24c22679",
          "duration": 4.013219954648526,
          "style_id": 1388823424,
          "intonationScale": 0.765,
          "postPitchScale": 1.1
        }
      }
    },
    {
      "id": "loss-01",
      "kind": "loss",
      "text": "今回は、私の勝ちですね。もう一度、いかがですか？",
      "files": {
        "expressive": {
          "path": "assets/voice/loss-01-expressive.wav",
          "sha256": "6b9f1796c5aec8122bcbac0227d411263a85dea86624eb268ad105232ecb0aed",
          "duration": 5.089455782312926,
          "style_id": 1388823424,
          "intonationScale": 0.9,
          "postPitchScale": 1.1
        },
        "calm": {
          "path": "assets/voice/loss-01-calm.wav",
          "sha256": "7624cd70b4571b2a6bffbdede70649a6618a87c3de0bac86eda57d7f11c35eda",
          "duration": 5.047301587301587,
          "style_id": 1388823424,
          "intonationScale": 0.765,
          "postPitchScale": 1.1
        }
      }
    },
    {
      "id": "loss-02",
      "kind": "loss",
      "text": "惜しかったですね。次のカードに、期待しましょう。",
      "files": {
        "expressive": {
          "path": "assets/voice/loss-02-expressive.wav",
          "sha256": "af5ebf57448ae15be600934ef93518ee2a70eb0b81ba2d8ee7b50348ac2cf464",
          "duration": 3.9317913832199545,
          "style_id": 1388823424,
          "intonationScale": 0.9,
          "postPitchScale": 1.1
        },
        "calm": {
          "path": "assets/voice/loss-02-calm.wav",
          "sha256": "5a886eca9aa56fa8a1e29ab19cb310aad661393c0df7c428c83d2c35ee034b68",
          "duration": 3.947278911564626,
          "style_id": 1388823424,
          "intonationScale": 0.765,
          "postPitchScale": 1.1
        }
      }
    },
    {
      "id": "loss-03",
      "kind": "loss",
      "text": "焦らなくて大丈夫。ゆっくりいきましょうね。",
      "files": {
        "expressive": {
          "path": "assets/voice/loss-03-expressive.wav",
          "sha256": "080010e6a631515abb114de238329a1a5a005f8d4dfc0090e72a79ef2e5e3294",
          "duration": 3.283333333333333,
          "style_id": 1388823424,
          "intonationScale": 0.9,
          "postPitchScale": 1.1
        },
        "calm": {
          "path": "assets/voice/loss-03-calm.wav",
          "sha256": "3cab5bc1d868e12e17f2393d4a918a64db714d199c9af0ba20dfa671316eb64c",
          "duration": 3.2378684807256235,
          "style_id": 1388823424,
          "intonationScale": 0.765,
          "postPitchScale": 1.1
        }
      }
    },
    {
      "id": "loss-04",
      "kind": "loss",
      "text": "今回は、こちらに流れが来たみたいです。",
      "files": {
        "expressive": {
          "path": "assets/voice/loss-04-expressive.wav",
          "sha256": "7c4db24d62ae615e0069001a696e1451d7f2bb2b68d5ce040086e476838f2222",
          "duration": 3.103469387755102,
          "style_id": 1388823424,
          "intonationScale": 0.9,
          "postPitchScale": 1.1
        },
        "calm": {
          "path": "assets/voice/loss-04-calm.wav",
          "sha256": "ed2cc0dd9cc674b9542f344200fe58dbeb2c7c4d17a44fb9466e7f166b88c3e3",
          "duration": 3.1040362811791384,
          "style_id": 1388823424,
          "intonationScale": 0.765,
          "postPitchScale": 1.1
        }
      }
    },
    {
      "id": "loss-05",
      "kind": "loss",
      "text": "いい勝負でした。次は、どうなるでしょうね。",
      "files": {
        "expressive": {
          "path": "assets/voice/loss-05-expressive.wav",
          "sha256": "e568c850d30070e0cd59c1298ad0c91f15be04a3704644da11717d3ffa5aac47",
          "duration": 3.5734467120181406,
          "style_id": 1388823424,
          "intonationScale": 0.9,
          "postPitchScale": 1.1
        },
        "calm": {
          "path": "assets/voice/loss-05-calm.wav",
          "sha256": "6d2f6bc248d5458a967c4774cb00faf8a52db831346d2909d1ea02b42201b619",
          "duration": 3.550498866213152,
          "style_id": 1388823424,
          "intonationScale": 0.765,
          "postPitchScale": 1.1
        }
      }
    },
    {
      "id": "loss-06",
      "kind": "loss",
      "text": "勝負は、まだまだこれから。お付き合いくださいね。",
      "files": {
        "expressive": {
          "path": "assets/voice/loss-06-expressive.wav",
          "sha256": "29a76cab13b8a8011f5450be67e2fc867d12075e5af8903c744045de029a7b27",
          "duration": 4.055283446712018,
          "style_id": 1388823424,
          "intonationScale": 0.9,
          "postPitchScale": 1.1
        },
        "calm": {
          "path": "assets/voice/loss-06-calm.wav",
          "sha256": "3c67bf56b0d36bada0351c9f4a99f5512ea037d43ad67efcee599a6ccfa89900",
          "duration": 4.107392290249433,
          "style_id": 1388823424,
          "intonationScale": 0.765,
          "postPitchScale": 1.1
        }
      }
    },
    {
      "id": "tie-01",
      "kind": "tie",
      "text": "引き分けですね。なんだか、息がぴったりです。",
      "files": {
        "expressive": {
          "path": "assets/voice/tie-01-expressive.wav",
          "sha256": "35732b9acfd18f8c943e7bd79f3fb6a38c1f516941ad0f9287961668344cde7e",
          "duration": 3.8756916099773244,
          "style_id": 1388823424,
          "intonationScale": 0.9,
          "postPitchScale": 1.1
        },
        "calm": {
          "path": "assets/voice/tie-01-calm.wav",
          "sha256": "0ba62e8435cafb74fa657ed4e9cea24c54c8112091d3a62d68f93faaadf45fed",
          "duration": 3.859455782312925,
          "style_id": 1388823424,
          "intonationScale": 0.765,
          "postPitchScale": 1.1
        }
      }
    },
    {
      "id": "tie-02",
      "kind": "tie",
      "text": "互角の勝負でしたね。次こそ、決着でしょうか。",
      "files": {
        "expressive": {
          "path": "assets/voice/tie-02-expressive.wav",
          "sha256": "6035b4dadab469ae7a090feb5e0b62a5fd3464115c93e4bdc325b0568aa670f1",
          "duration": 4.160975056689343,
          "style_id": 1388823424,
          "intonationScale": 0.9,
          "postPitchScale": 1.1
        },
